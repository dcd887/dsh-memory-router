{
  "note": "EDG 决策图。改完要重启 DSH 才生效（刻意如此，避免半截配置生效）。节点按顺序试，第一个匹配且守卫为真的生效。",
  "nodes": [
    {
      "id": "tax-table-pick-fields",
      "comment": "税则通那种大表：模型只要几个字段，别把 8972 条全喂进去",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "hs_codes"
          }
        }
      },
      "guard": {
        "minChars": 2000
      },
      "then": [
        {
          "act": "readJson",
          "path": "${args.file_path}",
          "limit": 3,
          "pick": [
            "hs_code",
            "name",
            "import_tariff",
            "category"
          ]
        }
      ],
      "terminal": false
    },
    {
      "id": "blind-push-summary",
      "comment": "盲推记录：只看结论与卡点，不要整篇上万字",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "盲推"
          }
        }
      },
      "guard": {
        "minChars": 4000
      },
      "then": [
        {
          "act": "grep",
          "path": "${args.file_path}",
          "pattern": "^#{1,3} |错误|失败|结论|凶手",
          "maxLines": 40
        },
        {
          "act": "stat",
          "path": "${args.file_path}"
        }
      ],
      "terminal": false
    },
    {
      "id": "verdict-json-digest",
      "comment": "判案/构建的产出：只抓错误与通过数",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "result|report|判案|构建"
          }
        }
      },
      "guard": {
        "all": [
          {
            "minChars": 3000
          },
          {
            "regex": "错误|error|通过|pass|失败"
          }
        ]
      },
      "then": [
        {
          "act": "grep",
          "path": "${args.file_path}",
          "pattern": "错误|error|通过|失败|count|total",
          "maxLines": 30
        }
      ],
      "terminal": false
    },
    {
      "id": "grep-json-when-huge",
      "comment": "读大 JSON 又只想看某几个键：按正则抓行，不整份返回",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "\\.json$"
          }
        }
      },
      "guard": {
        "all": [
          {
            "minChars": 8000
          }
        ]
      },
      "then": [
        {
          "act": "grep",
          "path": "${args.file_path}",
          "pattern": "hs_code|\"name\"|status|error",
          "maxLines": 40
        }
      ],
      "terminal": false
    },
    {
      "id": "md-outline-when-huge",
      "comment": "读很长的 md，先给标题骨架，别整篇塞进去",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "\\.md$"
          }
        }
      },
      "guard": {
        "all": [
          {
            "minChars": 8000
          }
        ]
      },
      "then": [
        {
          "act": "grep",
          "path": "${args.file_path}",
          "pattern": "^#{1,3} ",
          "maxLines": 50
        },
        {
          "act": "stat",
          "path": "${args.file_path}"
        }
      ],
      "terminal": false
    },
    {
      "id": "log-errors-only",
      "comment": "读日志：只要错误行，不要上万行 INFO",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "\\.log$"
          }
        }
      },
      "guard": {
        "all": [
          {
            "minChars": 4000
          },
          {
            "regex": "ERROR|WARN|Traceback|Exception"
          }
        ]
      },
      "then": [
        {
          "act": "grep",
          "path": "${args.file_path}",
          "pattern": "ERROR|WARN|Traceback|Exception|FATAL",
          "maxLines": 30
        },
        {
          "act": "stat",
          "path": "${args.file_path}"
        }
      ],
      "terminal": false
    },
    {
      "id": "csv-head-only",
      "comment": "读大 CSV：先给表头与前三行，别整份塞进来",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "\\.csv$"
          }
        }
      },
      "guard": {
        "minChars": 4000
      },
      "then": [
        {
          "act": "readFileSlice",
          "path": "${args.file_path}",
          "from": 0,
          "lines": 4
        },
        {
          "act": "stat",
          "path": "${args.file_path}"
        }
      ],
      "terminal": false
    },
    {
      "id": "package-json-summary",
      "comment": "读 package.json：只要名字、版本、脚本名",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "package\\.json$"
          }
        }
      },
      "guard": {
        "minChars": 1500
      },
      "then": [
        {
          "act": "readJson",
          "path": "${args.file_path}",
          "limit": 1,
          "pick": [
            "name",
            "version",
            "license"
          ]
        }
      ],
      "terminal": false
    },
    {
      "id": "pytest-output-digest",
      "comment": "跑完测试读完整输出：只留失败行与汇总行",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "(pytest|pytest_out|test.*\\.log)$"
          }
        }
      },
      "guard": {
        "all": [
          {
            "minChars": 3000
          },
          {
            "regex": "passed|failed|FAILED|PASSED"
          }
        ]
      },
      "then": [
        {
          "act": "grep",
          "path": "${args.file_path}",
          "pattern": "FAILED|ERROR|failed|passed|error|warnings summary",
          "maxLines": 40
        },
        {
          "act": "stat",
          "path": "${args.file_path}"
        }
      ],
      "terminal": false
    },
    {
      "id": "git-diff-stat-only",
      "comment": "读 diff：只要文件与增删行数，不要整份补丁",
      "match": {
        "tool": "read",
        "args": {
          "file_path": {
            "$re": "\\.(diff|patch)$"
          }
        }
      },
      "guard": {
        "minChars": 2000
      },
      "then": [
        {
          "act": "grep",
          "path": "${args.file_path}",
          "pattern": "^\\+\\+\\+ |^--- |^@@|^diff --git",
          "maxLines": 40
        },
        {
          "act": "stat",
          "path": "${args.file_path}"
        }
      ],
      "terminal": false
    }
  ]
}
